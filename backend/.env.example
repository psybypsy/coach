ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SUPABASE_URL=https://hqpfmpuvgwmszajmgwqq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=http://localhost:5174,https://your-vercel-domain.vercel.app

# ── 學員報告 Email（Gmail SMTP，不需自有網域、不必設定 DNS）──
# GMAIL_APP_PASSWORD 是 Google 帳號的「應用程式密碼」（需先開啟兩步驟驗證），不是登入密碼。
# 兩個都沒設定時完全不寄信，其餘功能照常運作。設定步驟見 docs/report-email.md。
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
REPORT_FROM_NAME=Ipsen Taiwan
APP_BASE_URL=https://coach-roan-eta.vercel.app

# Supabase Database Webhook 用（週記寫滿五題後自動產生並寄出報告）。留空則停用 webhook。
REPORT_WEBHOOK_SECRET=

# 學員端 /api/member/report 的速率限制，預設 6/hour（防止刷爆 AI 費用）。
# 測試期間可調寬，例如 100/hour；正式上線前記得拿掉或改回小數字。
MEMBER_REPORT_RATE_LIMIT=6/hour

PORT=8000
