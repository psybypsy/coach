ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SUPABASE_URL=https://hqpfmpuvgwmszajmgwqq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=http://localhost:5174,https://your-vercel-domain.vercel.app

# ── 學員報告 Email ──
# 管道優先序：Brevo → Gmail API → Gmail SMTP。全都沒設就完全不寄信，其餘功能照常運作。
# Render 免費方案封鎖所有對外 SMTP 埠（25／465／587），SMTP 在正式環境一定逾時，
# 所以正式環境只能走前兩條（都是 HTTPS 443）。

# 【正式環境用這條】Brevo：免費 300 封/天，只要一把 API key。設定見 docs/brevo-setup.md。
BREVO_API_KEY=
# 寄件位址，必須先在 Brevo 後台完成「寄件者驗證」；沒設就沿用 GMAIL_ADDRESS。
REPORT_FROM_EMAIL=

# 寄件位址（走 Gmail 的兩條管道一定得用這個，Gmail 不允許代寄任意位址）。
GMAIL_ADDRESS=

# 【備援】Gmail API：免費且 DKIM 天然對齊，但要在 Google Cloud 跑 OAuth 設定。
# 取得方式：cd backend && python tools/get_gmail_refresh_token.py（見 docs/gmail-api-setup.md）
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# 【本機開發用】Google 帳號的「應用程式密碼」（需先開啟兩步驟驗證），不是登入密碼。
GMAIL_APP_PASSWORD=
REPORT_FROM_NAME=Ipsen Taiwan
APP_BASE_URL=https://coach-roan-eta.vercel.app

# Supabase Database Webhook 用（週記寫滿五題後自動產生並寄出報告）。留空則停用 webhook。
REPORT_WEBHOOK_SECRET=

# 學員端 /api/member/report 的速率限制，預設 6/hour（防止刷爆 AI 費用）。
# 測試期間可調寬，例如 100/hour；正式上線前記得拿掉或改回小數字。
MEMBER_REPORT_RATE_LIMIT=6/hour

PORT=8000
